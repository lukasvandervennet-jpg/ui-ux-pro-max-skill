# Definitief domein van de website (zonder slash op het einde)
NEXT_PUBLIC_SITE_URL=https://www.lamoustache-latem.be

# ── Online afspraken ─────────────────────────────────────────────
# off  = knoppen verwijzen naar WhatsApp (standaard)
# demo = boekingspagina werkt, maar er wordt niets echt geboekt of gemaild
# live = echte boekingen in Google Agenda + e-mails
NEXT_PUBLIC_BOOKING_MODE=off

# Google Agenda (serviceaccount, zie README → Online afspraken)
GOOGLE_SERVICE_ACCOUNT_EMAIL=boekingen@jouw-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=aziz@gmail.com

# E-mail — optie 1: Gmail met een app-wachtwoord (geen domeinnaam nodig)
SMTP_USER=barbershopeeklo@gmail.com
SMTP_PASS="abcd efgh ijkl mnop"
# (SMTP_HOST en SMTP_PORT leeg laten voor Gmail)

# E-mail — optie 2: Resend (heeft voorrang als ingevuld)
RESEND_API_KEY=
MAIL_FROM="La Moustache <afspraken@jouwdomein.be>"
MAIL_REPLY_TO=barbershopeeklo@gmail.com

# Lange willekeurige tekst voor veilige annuleerlinks (bv. `openssl rand -hex 32`)
BOOKING_SECRET=

# Beveiligt de dagelijkse bedankmail-taak (Vercel stuurt dit automatisch mee)
CRON_SECRET=

# Optioneel: ook een mail naar Aziz bij elke nieuwe boeking of annulering
BOOKING_NOTIFY_EMAIL=
